{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RongxiuCandidateResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "purpose", "mode", "candidates", "promptVersion"],
  "oneOf": [
    {"properties": {"purpose": {"const": "INTRODUCTION"}, "mode": {"const": "polish"}}},
    {"properties": {"purpose": {"const": "CAPTION"}, "mode": {"const": "polish"}}},
    {"properties": {"purpose": {"const": "STORY"}, "mode": {"const": "body"}}},
    {"properties": {"purpose": {"const": "WISH"}, "mode": {"const": "polish"}}},
    {"properties": {"purpose": {"const": "COLLECTIVE_LETTER"}, "mode": {"const": "generate"}}},
    {"properties": {"purpose": {"const": "POST_EVENT_MESSAGE"}, "mode": {"const": "polish"}}},
    {"properties": {"purpose": {"const": "INVITATION_MESSAGE"}, "mode": {"const": "polish"}}},
    {"properties": {"purpose": {"const": "COLLECTIVE_LETTER"}, "mode": {"const": "edit"}}}
  ],
  "properties": {
    "status": {"const": "SUCCESS"},
    "purpose": {"type": "string"},
    "mode": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "violations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "promptVersion": {"type": "string", "minLength": 1},
    "modelVersion": {"type": "string"},
    "traceId": {"type": "string"}
  }
}
