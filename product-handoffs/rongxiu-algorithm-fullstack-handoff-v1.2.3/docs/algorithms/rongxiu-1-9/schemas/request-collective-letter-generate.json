{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CollectiveLetterGenerateRequest",
  "type": "object",
  "required": ["recipientLabel", "materials", "inputHash"],
  "additionalProperties": false,
  "properties": {
    "recipientLabel": {"type": "string", "minLength": 1, "maxLength": 100},
    "style": {"type": "string", "enum": ["natural_oral", "soft_literary", "calm_dignified", "formal_sincere"], "default": "natural_oral"},
    "inputHash": {"type": "string", "minLength": 1},
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "approved-material.json"}
    }
  }
}
