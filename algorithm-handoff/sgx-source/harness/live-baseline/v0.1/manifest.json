{
  "schemaVersion": "sgx-live-model-baseline-v0.1",
  "status": "phase_0_in_progress_paid_calls_disabled",
  "createdAt": "2026-10-02",
  "architecture": "modular_asr_policy_llm_memory_tts",
  "paidExecutionEnabled": false,
  "claimBoundary": "Fixed fictional engineering baseline and internal-adult roleplay only; no real-elder, production, clinical, psychological, cognitive, or scientific-effect claim.",
  "providers": {
    "asr": { "provider": "doubao", "resourceId": "VERIFY_IN_PREFLIGHT", "mode": "independent_streaming_asr" },
    "tts": { "provider": "doubao", "resourceId": "seed-tts-2.0", "voiceId": "VERIFY_IN_PREFLIGHT" },
    "text": { "provider": "volcengine_ark", "model": "doubao-seed-2-0-lite-260428", "apiStyle": "openai_compatible" }
  },
  "authorization": {
