# 复制为 .env.local；只在本机填值，不提交凭据。
# 默认仅运行 Fake，不调用模型。使用真实模型时，先核对累计账本再分配本实例额度。
SGX_ALGORITHM_MODE=fake
SGX_ALGORITHM_FAKE_MODE=1
SGX_ALGORITHM_BUILD_ID=pre-human-2026-10-15-candidate-v23-gitee.1
SGX_SEMANTIC_TURN_SHADOW=0
SGX_INTERNAL_BATCH_CAP_CNY=0
SGX_INTERNAL_PRIOR_EXPOSURE_CNY=400

LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-2-0-lite-260428

# 独立流式 ASR；不使用录音文件 auc 接口或端到端实时语音。
# DOUBAO_ASR_ENDPOINT 不填写时采用源码内固定的双向流式端点。
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
