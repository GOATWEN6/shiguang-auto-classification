{
  "name": "ai-memoir-assistant",
  "version": "1.0.0",
  "description": "AI 回忆录助手 - 面向老年用户的智能人生故事记录与回忆录生成系统",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit --incremental false",
    "prepare:vad": "node scripts/prepare-vad-assets.mjs",
    "test:handoff": "npm run test:handoff:core && npm run test:handoff:persistence && npm run test:handoff:api",
    "test:handoff:core": "node --experimental-strip-types --test harness/live-baseline/v0.1/algorithm-composition.test.mts harness/live-baseline/v0.1/g2-real-provider-regressions.test.mts harness/live-baseline/v0.1/g4-derived-artifact-runtime.test.mts",
    "test:handoff:persistence": "node --experimental-strip-types --test harness/live-baseline/v0.1/test-workspace-store.test.mts harness/live-baseline/v0.1/evidence-store-persistence.test.mts harness/live-baseline/v0.1/algorithm-composition-persistence.test.mts harness/live-baseline/v0.1/algorithm-lab-workspace-ui.test.mts harness/live-baseline/v0.1/cost-ledger.test.mts harness/live-baseline/v0.1/cloudflare-deployment-config.test.mts harness/live-baseline/v0.1/macos-service-config.test.mts",
    "test:handoff:api": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-module-mocks --loader ./harness/live-baseline/v0.1/next-server-loader.mjs --test harness/live-baseline/v0.1/workspace-api.test.mts harness/live-baseline/v0.1/http-route-boundary.test.mts"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "next": "14.2.3",
    "openai": "^4.52.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "ws": "8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "8.18.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
